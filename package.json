{
  "name": "xo-beta",
  "version": "0.2.0",
  "description": "Xo Beta — a browser-native single-player 3D battle royale FPS/TPS. 10 combatants, last one standing wins.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TKY-27/Xo-Beta.git"
  },
  "homepage": "https://github.com/TKY-27/Xo-Beta#readme",
  "bugs": {
    "url": "https://github.com/TKY-27/Xo-Beta/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && sh scripts/check-dist.sh",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "tsx tests/sim/run-sim.ts",
    "lint": "eslint .",
    "audit:assets": "sh scripts/check-assets.sh",
    "audit:dist": "sh scripts/check-dist.sh",
    "audit:secrets": "sh scripts/check-secrets.sh",
    "audit:licenses": "license-checker-rseidelsohn --excludePrivatePackages --onlyAllow 'MIT;BSD-2-Clause;BSD-3-Clause;Apache-2.0;ISC;0BSD;Zlib;CC0-1.0;BlueOak-1.0.0' --production --summary",
    "cloudflare:dry-run": "npm run build && wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/three": "^0.182.0",
    "eslint": "^9.39.5",
    "license-checker-rseidelsohn": "^4.0.6",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  }
}
